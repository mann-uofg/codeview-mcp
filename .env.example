# Copy to .env (git-ignored) or export these in your shell. Every key is optional.

# Free AI providers: set at least one for the AI review pass.
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
# RG_OLLAMA=1                  # use a local Ollama server (or set OLLAMA_HOST)

# Any other OpenAI-compatible endpoint
# RG_BASE_URL=https://example.com/v1
# RG_MODEL=
# RG_API_KEY=

# Provider / model overrides
# RG_PROVIDER=auto
# RG_MODEL=

# GitHub: needed for private repos and posting reviews (or run `gh auth login`)
GITHUB_TOKEN=
